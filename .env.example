# Base URL of the AttendanceApi (see api-docs.json). Trailing slash optional.
ATTENDANCE_API_URL=http://localhost:5261/

# Base URL of the student-facing check-in web page. If set, the QR code
# encodes a deep link ({url}/checkin?class={classSessionId}&code={code})
# instead of the bare code, so a phone camera can jump straight there. If
# unset, or no session could be resolved, the QR falls back to the bare code.
#ATTENDANCE_FRONTEND_URL=

# --- Auth (pick at most one of the following) ---------------------------
# Preferred for a deployed kiosk: a CheckInEndpoint device key, format
# "{id}.{secret}", issued once by an admin via POST /api/endpoints and never
# tied to a user account. Its room is baked into the key itself (server-side
# room_id claim) — ATTENDANCE_ROOM below is ignored when this is set, since
# the app instead calls the endpoint-only GET /api/Classes/schedule.
#ATTENDANCE_API_KEY=

# A pre-issued user bearer token. Takes priority over email/password and dev-token.
#ATTENDANCE_API_TOKEN=

# Email/password login (POST /api/Auth/login).
#ATTENDANCE_API_EMAIL=
#ATTENDANCE_API_PASSWORD=

# If none of the above is set, the app falls back to
# GET /api/Auth/dev-token for local development. Optionally pin a role
# (integer value of the UserRole enum) for the issued dev token.
#ATTENDANCE_API_ROLE=

# --- Check-in session -----------------------------------------------------
# Which ClassSession's rotating code (GET /api/ClassSessions/{id}/totp) to
# display. If unset, the app picks the most recent session of the first
# class returned by GET /api/Classes (or, under ATTENDANCE_API_KEY auth,
# the first class in the endpoint's own room).
#ATTENDANCE_CLASS_SESSION_ID=

# --- Header bar -------------------------------------------------------------
# Room label shown in the top-right header, and (under user/JWT auth only)
# the room classes/sessions are filtered to. If unset, falls back to the
# room of the first scheduled class. Ignored under ATTENDANCE_API_KEY auth,
# where the room comes from the key itself.
#ATTENDANCE_ROOM=

# --- NFC auto-checkin (RC522) -----------------------------------------------
# Only used under ATTENDANCE_API_KEY (endpoint) auth: on each card tap, the
# app reads the card's UID over SPI and POSTs it to
# /api/ClassSessions/auto-checkin, which resolves both the student (by
# registered card) and the class session (by the endpoint's room + current
# time) server-side. Defaults to /dev/spidev0.0 (SPI0, CE0) if unset; only
# needed if your RC522 is wired to a different SPI bus/chip-select. If no
# reader responds there (SPI not enabled, wrong wiring, or no hardware at
# all, e.g. a dev machine), auto-checkin just stays disabled -- see
# nfc_reader.h for wiring notes.
#ATTENDANCE_NFC_SPI_DEVICE=/dev/spidev0.0

# --- Schedule filtering ------------------------------------------------------
# If set to "1" or "2", hides schedule rows for the other sprint. Matching is
# by looking for "Sprint <N>" in the class name (e.g. "... (Sprint 2)"); a
# class whose name doesn't mention a sprint at all is always shown.
#ATTENDANCE_SPRINT=

# --- Debugging --------------------------------------------------------------
# Overrides the wall-clock time used to pick which schedule row is
# highlighted as the current class, e.g. "09:45". Lets you verify the
# highlight without waiting for a real class to start. Leave unset in
# production.
#ATTENDANCE_DEBUG_TIME=
