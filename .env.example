# Base URL of the AttendanceApi (see api-docs.json). Trailing slash optional.
ATTENDANCE_API_URL=http://localhost:5261/

# --- Auth (pick at most one of the following) ---------------------------
# Preferred for a deployed kiosk: a CheckInEndpoint device key, format
# "{id}.{secret}", issued once by an admin via POST /api/endpoints and never
# tied to a user account. Its room is baked into the key itself (server-side
# room_id claim) — ATTENDANCE_ROOM below is ignored when this is set, since
# the app instead calls the endpoint-only GET /api/Classes/schedule.
#ATTENDANCE_API_KEY=

# A pre-issued user bearer token. Takes priority over email/password and dev-token.
#ATTENDANCE_API_TOKEN=

# Email/password login (POST /api/Auth/login).
#ATTENDANCE_API_EMAIL=
#ATTENDANCE_API_PASSWORD=

# If none of the above is set, the app falls back to
# GET /api/Auth/dev-token for local development. Optionally pin a role
# (integer value of the UserRole enum) for the issued dev token.
#ATTENDANCE_API_ROLE=

# --- Check-in session -----------------------------------------------------
# Which ClassSession's rotating code (GET /api/ClassSessions/{id}/totp) to
# display. If unset, the app picks the most recent session of the first
# class returned by GET /api/Classes (or, under ATTENDANCE_API_KEY auth,
# the first class in the endpoint's own room).
#ATTENDANCE_CLASS_SESSION_ID=

# --- Header bar -------------------------------------------------------------
# Room label shown in the top-right header, and (under user/JWT auth only)
# the room classes/sessions are filtered to. If unset, falls back to the
# room of the first scheduled class. Ignored under ATTENDANCE_API_KEY auth,
# where the room comes from the key itself.
#ATTENDANCE_ROOM=
