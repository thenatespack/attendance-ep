[Unit]
Description=Attendance EP kiosk display
After=graphical.target display-manager.service
Wants=graphical.target

# graphical.target can report active slightly before the desktop
# session/X server is actually ready to accept connections; ordering after
# display-manager.service too (the actual X/lightdm service, aliased to
# whichever display manager is installed) is a closer proxy for "X is
# really up" than the target alone. Even so, this can still race -- see
# the Restart= comment below for what happens when it does. Uncapping the
# restart-rate limit means a flaky boot that needs several quick restarts
# in a row still ends up running, instead of systemd giving up after its
# default 5-in-10s burst and leaving the unit "failed".
StartLimitIntervalSec=0

[Service]
Type=simple
User=endpoint
Group=endpoint
WorkingDirectory=/opt/attendance-ep
ExecStart=/opt/attendance-ep/imgui-test

# --- GUI environment: VERIFY on the actual Pi before relying on these ---
# Assumes desktop autologin as "endpoint" on DISPLAY :0 (X11 or XWayland).
# If the Pi uses a different user, a Wayland-only compositor with no
# XWayland, or a different DISPLAY number, these must be adjusted --
# otherwise SDL_CreateWindow fails to find a display and the service
# crash-loops. Check with `echo $DISPLAY` in the Pi's actual desktop
# session.
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/endpoint/.Xauthority

# Restart unconditionally, not just on-failure: main() exits with code 0
# (a "clean" exit as far as systemd's concerned) if it ever receives an
# SDL_QUIT/window-close event, which can happen if this races ahead of the
# desktop session/X server actually being ready to accept connections right
# after graphical.target is reached -- on-failure won't restart that, so
# the unit was observed sitting inactive after a reboot until started by
# hand. This is also a crash safety net between update cycles, not how
# updates get applied -- deploy/bin/update.py does its own explicit
# stop/swap/start around an update and distinguishes that from a
# systemd-triggered auto-restart via NRestarts (see update.py's health
# check), which tracks restarts under either policy the same way.
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
